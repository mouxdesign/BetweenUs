# Copy this file to .env.local and fill in your values.

# ImageKit URL endpoint for post cover images (Dashboard → Developer options).
# Example: https://ik.imagekit.io/your_id
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Canonical site origin, used for metadata, sitemap.xml and robots.txt.
# Defaults to https://www.betweenusstories.com if unset.
NEXT_PUBLIC_SITE_URL=https://www.betweenusstories.com
